# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=medstore
DB_USER=medstore_user
DB_PASS=replace_with_strong_password

# Application Secret Key (64-char hex string)
# Generate with: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
APP_KEY=replace_with_64_char_hex_key

# Google Gemini API Key for AI Invoice OCR (Optional)
# Get your key from Google AI Studio: https://aistudio.google.com
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Security & Environment
APP_ENV=production
FORCE_HTTPS=true
TIMEZONE=Asia/Kolkata
DEMO_MODE=false

# One-time web installer token (Leave empty once admin user is created)
SETUP_TOKEN=
